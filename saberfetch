        f" {g}│{r} {b}{c1}Packages {r}:: {specs['pkgs']}",
        f" {g}│{r} {b}{c1}Shell    {r}:: {specs['shell']}",
        f" {g}│{r} {b}{c1}Session  {r}:: {specs['session']}",
        f" {g}├───────────────────────────────────────────┤{r}",
