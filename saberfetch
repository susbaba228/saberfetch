def get_specs():
    specs = {}
    specs["os_release"] = platform.release()
    try:
        specs["user"] = os.getlogin()
        specs["hostname"] = platform.node()
    except:
        specs["user"] = "user"
        specs["hostname"] = "linux"

    # CPU
    specs["cpu"] = "Unknown CPU"
    if os.path.exists("/proc/cpuinfo"):
        with open("/proc/cpuinfo", "r") as f:
            for line in f:
                if "model name" in line:
                    specs["cpu"] = line.split(":")[1].strip().split("@")[0].strip()
                    break

    # RAM
    specs["ram"] = "Unknown RAM"
    if os.path.exists("/proc/meminfo"):
        mem_total = 0
        mem_available = 0
        with open("/proc/meminfo", "r") as f:
            for line in f:
                if "MemTotal" in line:
                    mem_total = int(line.split()[1])
                if "MemAvailable" in line:
                    mem_available = int(line.split()[1])
        if mem_total > 0:
            used = (mem_total - mem_available) / 1024 / 1024
            total = mem_total / 1024 / 1024
            pct = ((mem_total - mem_available) / mem_total) * 100
            specs["ram"] = f"{used:.2f} GiB / {total:.2f} GiB ({int(pct)}%)"

    # Shell & WM / Session
    specs["shell"] = os.path.basename(os.environ.get("SHELL", "unknown"))
    specs["session"] = os.environ.get("XDG_CURRENT_DESKTOP", "Hyprland")
    
    # Packages count
    specs["pkgs"] = "Unknown"
    if os.path.exists("/var/lib/pacman/local"):
        try:
            # Count folders in the pacman database directory (minus ALPM files)
            count = len([d for d in os.listdir("/var/lib/pacman/local") if not d.startswith(".")])
            specs["pkgs"] = f"{count} (pacman)"
        except:
            pass

    # Uptime
    specs["uptime"] = "Unknown"
    if os.path.exists("/proc/uptime"):
        with open("/proc/uptime", "r") as f:
            uptime_seconds = float(f.readline().split()[0])
            hours = int(uptime_seconds // 3600)
            minutes = int((uptime_seconds % 3600) // 60)
            specs["uptime"] = f"{hours}h {minutes}m" if hours > 0 else f"{minutes} mins"

    return specs

def main():
    target_distro_key = "arch"
    if os.path.exists("/etc/os-release"):
        with open("/etc/os-release", "r") as f:
            content = f.read().lower()
            for key in DISTROS.keys():
                if key in content:
                    target_distro_key = key

    if len(sys.argv) > 2 and sys.argv[1] == "-logo":
        requested = sys.argv[2].lower()
        if requested in DISTROS:
            target_distro_key = requested

    distro = DISTROS[target_distro_key]
    specs = get_specs()

    c1 = distro["primary_color"]
    c2 = distro["secondary_color"]
